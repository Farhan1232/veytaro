{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veytaro",
  "mainBinaryName": "Veytaro",
  "version": "0.1.0",
  "identifier": "app.veytaro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veytaro",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Veytaro",
    "homepage": "https://veytaro.app",
    "copyright": "© 2026 Veytaro",
    "category": "Utility",
    "shortDescription": "Football Manager save-file assistant",
    "longDescription": "Veytaro reads Football Manager 26 save files and resolves the managed club, current competition and season. Save files are only ever opened for reading.",
    "resources": [
      "resources/competition_names/fm26.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/windows/header.bmp",
        "sidebarImage": "installer/windows/sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "Veytaro",
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
