# Supabase (never commit real keys — copy to .env)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy alias (optional):
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: redirect target for password-reset / email confirmation links
# Must also be allowed in Supabase → Authentication → URL Configuration
# VITE_SUPABASE_REDIRECT_URL=http://localhost:1420
#
# Desktop tip: Email confirm links open in the system browser (localhost).
# For local development, prefer disabling "Confirm email" in
# Supabase → Authentication → Providers → Email.
